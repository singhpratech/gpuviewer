/target
**/*.rs.bk

# local recordings — never commit a history database or an exported incident slice
*.db
*.db-wal
*.db-shm
*.gpvr

# locally built release artifacts (tarballs, AppImage, deb/rpm) — produced by CI/packaging,
# never checked in
/dist

# Claude Code local state (agent worktrees, session files) — never part of the repo
/.claude/
